{
  // 도담테크산업 IT 운영 포털 (시뮬레이션)
  // 설정 스키마: node_modules 안의 wrangler 스키마로 자동 완성·검증을 받는다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ip-ops-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // 정적 화면(public/)을 Worker와 함께 배포한다.
  // 요청 경로에 맞는 파일이 있으면 파일을 주고, 없으면(/api/... 등) Worker 코드가 처리한다.
  // (설정 키 의미: 공식 문서 확인 필요 - Workers "Static Assets" 문서)
  "assets": {
    "directory": "./public"
  },

  // D1 데이터베이스. 코드에서는 env.DB 로 쓴다.
  // database_id 는 `npx wrangler d1 create ip-ops-portal-db` 출력값 (리전: APAC).
  // id는 비밀 값이 아니라서 저장소에 있어도 된다. 접근 권한은 Cloudflare 계정 인증으로 보호된다.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ip-ops-portal-db",
      "database_id": "0b56de8e-6209-433f-a55e-5a70e7117c4c",
      "migrations_dir": "migrations"
    }
  ],

  // 매일 데모 초기화: KST 04:30 = UTC 19:30 (Cron 은 UTC 기준 - 공식 문서 확인 필요)
  // B(Uptime Monitor)의 KST 04:00 초기화와 겹치지 않게 30분 뒤로 둔다.
  "triggers": {
    "crons": ["30 19 * * *"]
  },

  // 비밀 값(ADMIN_TOKEN)은 여기에 쓰지 않는다.
  // 로컬: .dev.vars / 배포: npx wrangler secret put ADMIN_TOKEN

  "observability": {
    "enabled": true
  }
}
